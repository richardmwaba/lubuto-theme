<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="lubuto">
  <enum id="org.gnome.shell.extensions.lubuto.color">
    <value value="0" nick="blue"/>
    <value value="1" nick="purple"/>
    <value value="2" nick="pink"/>
    <value value="3" nick="red"/>
    <value value="4" nick="orange"/>
    <value value="5" nick="yellow"/>
    <value value="6" nick="green"/>
    <value value="7" nick="teal"/>
    <value value="8" nick="grey"/>
  </enum>
  <enum id="org.gnome.shell.extensions.lubuto.color-scheme">
    <value value="0" nick="auto"/>
    <value value="1" nick="light"/>
    <value value="2" nick="dark"/>
  </enum>
  <enum id="org.gnome.shell.extensions.lubuto.light-style">
    <value value="0" nick="standard"/>
    <value value="1" nick="light"/>
  </enum>

  <schema id="org.gnome.shell.extensions.lubuto" path="/org/gnome/shell/extensions/lubuto/">
    <key name="theme-name" type="s">
      <default>"Lubuto"</default>
      <summary>Base theme name</summary>
      <description>The name the theme directories start with. Variants append the colour, the colour scheme and the size.</description>
    </key>
    <key name="color" enum="org.gnome.shell.extensions.lubuto.color">
      <default>"teal"</default>
      <summary>Accent colour variant</summary>
    </key>
    <key name="color-scheme" enum="org.gnome.shell.extensions.lubuto.color-scheme">
      <default>"auto"</default>
      <summary>Light or dark variant</summary>
      <description>With "auto" the shell theme follows the GNOME colour scheme.</description>
    </key>
    <key name="light-style" enum="org.gnome.shell.extensions.lubuto.light-style">
      <default>"standard"</default>
      <summary>Which variant to use when the scheme is light</summary>
      <description>"standard" keeps a dark top bar on the light variant. "light" uses the fully light variant.</description>
    </key>
    <key name="compact" type="b">
      <default>false</default>
      <summary>Use the compact size variant</summary>
    </key>
    <key name="blur-enabled" type="b">
      <default>true</default>
      <summary>Blur the wallpaper behind glass surfaces</summary>
    </key>
    <key name="blur-panel" type="b">
      <default>true</default>
      <summary>Glass behind the top panel</summary>
    </key>
    <key name="blur-overview" type="b">
      <default>true</default>
      <summary>Blurred wallpaper behind the overview</summary>
    </key>
    <key name="blur-popups" type="b">
      <default>true</default>
      <summary>Glass behind panel popovers</summary>
    </key>
    <key name="blur-dock" type="b">
      <default>true</default>
      <summary>Glass behind the dock</summary>
    </key>
    <key name="blur-radius" type="i">
      <range min="0" max="100"/>
      <default>30</default>
      <summary>Blur radius in logical pixels</summary>
    </key>
    <key name="blur-brightness" type="d">
      <range min="0.1" max="1.0"/>
      <default>0.75</default>
      <summary>Brightness of the blurred wallpaper</summary>
    </key>
    <key name="corners-enabled" type="b">
      <default>true</default>
      <summary>Round window corners</summary>
    </key>
    <key name="corners-radius" type="i">
      <range min="0" max="40"/>
      <default>16</default>
      <summary>Window corner radius in logical pixels</summary>
    </key>
    <key name="corners-shadow" type="b">
      <default>true</default>
      <summary>Draw a shadow under rounded windows</summary>
    </key>
    <key name="corners-keep-maximized" type="b">
      <default>false</default>
      <summary>Keep rounded corners on maximized windows</summary>
    </key>
    <key name="corners-keep-fullscreen" type="b">
      <default>false</default>
      <summary>Keep rounded corners on fullscreen windows</summary>
    </key>
    <key name="corners-blacklist" type="as">
      <default>[]</default>
      <summary>Window classes that keep square corners</summary>
    </key>
    <key name="dock-enabled" type="b">
      <default>true</default>
      <summary>Show the dock</summary>
    </key>
    <key name="dock-icon-size" type="i">
      <range min="24" max="96"/>
      <default>48</default>
      <summary>Dock icon size in logical pixels</summary>
    </key>
    <key name="dock-monitor" type="i">
      <default>-1</default>
      <summary>Monitor index for the dock, -1 for the primary monitor</summary>
    </key>
    <key name="dock-magnify" type="b">
      <default>true</default>
      <summary>Grow icons under the pointer</summary>
    </key>
    <key name="dock-reserve-space" type="b">
      <default>true</default>
      <summary>Keep windows from overlapping the dock</summary>
    </key>
    <key name="dock-show-apps" type="b">
      <default>true</default>
      <summary>Show the applications button</summary>
    </key>
    <key name="sync-gtk-theme" type="b">
      <default>true</default>
      <summary>Set the GTK theme to the same variant</summary>
      <description>Writes the selected variant to org.gnome.desktop.interface gtk-theme whenever it changes.</description>
    </key>
  </schema>
</schemalist>
